{
  "name": "nuvriqo-excel-report-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Visual, scheduled Excel reporting for Jira without Jira Automation rules.",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run check:ui && npm run build:admin && npm run build:hardware && npm run build:navigator && npm run build:portal-admin",
    "build:admin": "vite build --config static/admin-ui/vite.config.js",
    "build:hardware": "vite build --config static/hardware-ui/vite.config.js",
    "build:navigator": "vite build --config static/navigator-ui/vite.config.js",
    "build:portal-admin": "vite build --config static/portal-admin-ui/vite.config.js",
    "test": "node --experimental-default-type=module --test tests/*.test.js",
    "lint": "forge lint",
    "deploy": "npm run build && forge deploy",
    "check:ui": "nuvriqo-ui-check static/nuvriqo-v1.css static/admin-ui/src static/hardware-ui/src static/navigator-ui/src static/portal-admin-ui/src"
  },
  "dependencies": {
    "@forge/api": "^6.0.0",
    "@forge/bridge": "6.3.1",
    "@forge/events": "^2.0.0",
    "@forge/kvs": "^1.0.0",
    "@forge/react": "12.1.1",
    "@forge/resolver": "^1.7.0",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "linkify-it": "^5.0.2"
  },
  "devDependencies": {
    "@nuvriqo/ui": "github:rdersley/nuvriqo-ui#v0.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^7.0.0"
  }
}
