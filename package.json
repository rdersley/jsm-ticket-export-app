{
  "name": "nuvriqo-excel-report-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Visual, scheduled Excel reporting for Jira without Jira Automation rules.",
  "main": "src/index.js",
  "scripts": {
    "build": "npm run build:admin && npm run build:navigator",
    "build:admin": "vite build --config static/admin-ui/vite.config.js",
    "build:navigator": "vite build --config static/navigator-ui/vite.config.js",
    "test": "node --experimental-default-type=module --test tests/schedule.test.js tests/workbook.test.js",
    "lint": "forge lint",
    "deploy": "npm run build && forge deploy"
  },
  "dependencies": {
    "@forge/api": "^6.0.0",
    "@forge/bridge": "6.3.1",
    "@forge/events": "^2.0.0",
    "@forge/kvs": "^1.0.0",
    "@forge/react": "12.1.1",
    "@forge/resolver": "^1.7.0",
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "linkify-it": "^5.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
